# Copy this file to .env and fill in real values. Never commit .env.
POSTGRES_USER=claimguard
POSTGRES_PASSWORD=change-me
POSTGRES_DB=claimguard

DATABASE_URL=postgresql+psycopg://claimguard:change-me@localhost:5432/claimguard
REDIS_URL=redis://localhost:6379/0

LOG_LEVEL=INFO
ENVIRONMENT=development

LLM_PROVIDER=anthropic
LLM_MODEL_NAME=claude-sonnet-5
ANTHROPIC_API_KEY=sk-ant-fake-key-replace-me
# For a local model instead: LLM_PROVIDER=ollama, LLM_MODEL_NAME=llama3.1
OLLAMA_BASE_URL=http://localhost:11434
LLM_INPUT_PRICE_PER_MILLION_TOKENS=2.0
LLM_OUTPUT_PRICE_PER_MILLION_TOKENS=10.0
